{
  "name": "scanconverter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Digitalizzazione e re-impaginazione di documenti accademici: OCR (Nvidia Nemotron-Parse) → Typst (Google Gemini) → PDF vettoriale (Typst nativo/WASM).",
  "author": "ScanConverter",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "cap sync",
    "build:android": "vite build && cap sync android",
    "open:android": "cap open android",
    "electron": "electron .",
    "download:typst": "node scripts/download-typst.mjs",
    "test:native-engine": "node scripts/smoke-typst-engine.mjs",
    "test:layout-engine": "node scripts/smoke-layout-options.mjs",
    "test:desktop-bridge": "node scripts/smoke-electron.mjs",
    "build:desktop": "npm run download:typst && vite build && electron-builder"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.scanconverter.app",
    "productName": "ScanConverter",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/typst",
        "to": "typst",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/assets/fonts",
        "to": "fonts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron",
        "to": "native-engine",
        "filter": [
          "typst-engine.cjs",
          "typst-runner.cjs"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
